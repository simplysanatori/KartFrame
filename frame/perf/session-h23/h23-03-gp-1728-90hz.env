# Headset session 23, launch 3 of 4: 1728 per eye (the default size) at 90 Hz (KARTFRAME_REFRESH_HZ=90; each game frame spans 1.5 refreshes, interpolated).
# Routine: Grand Prix, 50cc or 100cc, any cup, at least one full race; also look at: the item in your hand, swing to throw, rumble on hits, the menu controllers in front of the screen, and a Time Trial ghost if time allows.
KARTFRAME_STEREO_PACKED=1
KARTFRAME_END_PHASE=after
KARTFRAME_MENU_CONTROLLERS=eyes
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_SESSION_ENV_ONCE=1
KARTFRAME_FPSLOG=1
KARTFRAME_REFRESH_HZ=90
