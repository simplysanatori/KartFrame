# Headset session 25, launch 1 of 3: the narrow worker lock (KARTFRAME_WORKER_LOCK=narrow) (defaults otherwise: GX thread on, 90 Hz, interpolation 33 ms, 1728 per eye, packed swapchain, end lock after).
# Routine: Grand Prix, one FULL race, same cup/track for all three, head turns; report: full speed or slowdown (when), stutter, any visual fault (wrong textures, flicker, missing geometry), and whether the app name/overlays now say KartFrame.
KARTFRAME_STEREO_PACKED=1
KARTFRAME_END_PHASE=after
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_SESSION_ENV_ONCE=1
KARTFRAME_FPSLOG=1
KARTFRAME_CPULOG=1
KARTFRAME_WORKER_LOCK=narrow
