# Headset session 21, launch 3 of 6: packed alone, KARTFRAME_END_PHASE=off: frames handed over at the wake-up as before the end lock (no added latency). The ideal result if packing alone fixes the doubling.
# Routine: menus, Time Trial on Luigi Circuit, head turns at the countdown and while driving, hold still, one eye closed then the other, quit.
KARTFRAME_STEREO_PACKED=1
KARTFRAME_END_PHASE=off
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_SESSION_ENV_ONCE=1
