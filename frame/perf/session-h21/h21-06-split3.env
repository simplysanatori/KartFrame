# Headset session 21, launch 6 of 6: KARTFRAME_SET_SUBMIT_SPLIT=3: a set's GPU work as three queue submissions (eye 0, eye 1, sink) instead of one, so the compositor can interleave. Per-eye swapchains, end lock as default.
# Routine: menus, Time Trial on Luigi Circuit, head turns at the countdown and while driving, hold still, one eye closed then the other, quit.
KARTFRAME_SET_SUBMIT_SPLIT=3
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_SESSION_ENV_ONCE=1
