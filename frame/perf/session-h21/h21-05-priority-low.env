# Headset session 21, launch 5 of 6: KARTFRAME_QUEUE_PRIORITY=low: our queue at low global priority so SteamVR's compositor work is not delayed by the set queued ahead of it. Per-eye swapchains, end lock as default.
# Routine: menus, Time Trial on Luigi Circuit, head turns at the countdown and while driving, hold still, one eye closed then the other, quit.
KARTFRAME_QUEUE_PRIORITY=low
KARTFRAME_FRAME_LOG=1
KARTFRAME_VRTIMING_FRAMES=1
KARTFRAME_SESSION_ENV_ONCE=1
